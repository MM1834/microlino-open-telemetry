+++ "/mnt/data/mot_rev2/microlino-open-telemetry Kopie/firmware/common/web/http_not_found.h"	2026-07-30 07:48:35.888959474 +0000
@@ -0,0 +1,49 @@
+#pragma once
+
+#include <Arduino.h>
+#include <ArduinoJson.h>
+#include <WebServer.h>
+
+namespace MotHttp {
+
+inline const char* methodName(HTTPMethod method)
+{
+    switch (method) {
+        case HTTP_GET: return "GET";
+        case HTTP_HEAD: return "HEAD";
+        case HTTP_POST: return "POST";
+        case HTTP_PUT: return "PUT";
+        case HTTP_PATCH: return "PATCH";
+        case HTTP_DELETE: return "DELETE";
+        case HTTP_OPTIONS: return "OPTIONS";
+        default: return "UNKNOWN";
+    }
+}
+
+inline void registerFallbackRoutes(WebServer &server)
+{
+    // Browsers request this automatically. A 204 avoids a misleading 404 log.
+    server.on("/favicon.ico", HTTP_GET, [&server]() {
+        server.send(204);
+    });
+
+    server.onNotFound([&server]() {
+        const String path = server.uri();
+        const char* method = methodName(server.method());
+
+        Serial.printf("[HTTP] 404 %s %s\n", method, path.c_str());
+
+        JsonDocument response;
+        response["success"] = false;
+        response["status"] = 404;
+        response["error"] = "Not Found";
+        response["method"] = method;
+        response["path"] = path;
+
+        String payload;
+        serializeJson(response, payload);
+        server.send(404, "application/json", payload);
+    });
+}
+
+} // namespace MotHttp
