+
+static String lilygoUtcText()
+{
+    time_t now = time(nullptr);
+    if (now <= 1700000000) return "not-synchronized";
+    struct tm utcTm;
+    gmtime_r(&now, &utcTm);
+    char buffer[24];
+    strftime(buffer, sizeof(buffer), "%Y-%m-%dT%H:%M:%SZ", &utcTm);
+    return String(buffer);
+}
+
+static void handleSystemHealth()
